{
  "name": "earthsignal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test src/*.test.ts server/*.test.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "node --env-file-if-exists=.env.local --experimental-strip-types server/index.ts",
    "start": "node --env-file-if-exists=.env.local --experimental-strip-types server/index.ts",
    "db:import": "node --env-file-if-exists=.env.local --experimental-strip-types server/import.ts",
    "lmstudio:setup": "node scripts/setup-lmstudio.mjs",
    "test:live": "node --env-file-if-exists=.env.local --experimental-strip-types server/live-check.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
