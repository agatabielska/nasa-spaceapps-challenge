# Model connection is server-side only. No API key may use the VITE_ prefix.
# Keep lmstudio for local inference, or set gemini for Google AI Studio Gemini API.
ORBIT_PROVIDER=lmstudio
ORBIT_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local model settings (ignored when ORBIT_PROVIDER=gemini).
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Set to the exact identifier shown in LM Studio /v1/models.
# Leave empty to auto-select when exactly one model is available.
LMSTUDIO_MODEL=earthsignal/orbit-qwen3.6
# Only needed if authentication is enabled in LM Studio.
LMSTUDIO_API_KEY=
API_PORT=8787
EARTHSIGNAL_DB_PATH=.local/earthsignal.sqlite

# Render deployment: its PORT, RENDER and RENDER_EXTERNAL_URL are detected automatically.
# For a map-only deployment set ORBIT_ENABLED=false.
# ORBIT_ENABLED=false
# PUBLIC_URL=https://your-service.onrender.com
# HOST=0.0.0.0
